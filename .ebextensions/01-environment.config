# Menu Hero Core — Elastic Beanstalk environment configuration.
#
# Applied by `eb create` / `eb deploy` on the
# "Docker running on 64bit Amazon Linux 2023" platform. Settings changed later
# in the console or with `eb setenv` take precedence over this file.
#
# SECRETS ARE NEVER COMMITTED. SECRET_KEY, DATABASE_URL and LLM_API_KEY must be
# provided out of band, e.g.
#
#   eb setenv SECRET_KEY=... LLM_API_KEY=... \
#     DATABASE_URL='mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/menuhero?retryWrites=true&w=majority'
#
# or via Configuration -> Software -> Environment properties in the console.

option_settings:
  # Single EC2 instance, no load balancer (cheapest; see deploy/README.md for HTTPS).
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance

  aws:ec2:instances:
    InstanceTypes: t3.small

  # Used by the load balancer (if one is added later) and shown in the console.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health

  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  # The image is built on the instance (npm ci + nuxt build + uv sync);
  # give the deployment more than the default 10 minutes on a small box.
  aws:elasticbeanstalk:command:
    Timeout: 1800

  # Non-secret runtime environment for the container. The backend Settings
  # reads APP_ENV/LOG_LEVEL/CORS_ORIGINS, the agents package reads LLM_PROVIDER.
  # Replace CORS_ORIGINS with the real public origin(s), comma-separated.
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    LOG_LEVEL: INFO
    LLM_PROVIDER: stub
    CORS_ORIGINS: https://example.com
