# Menu Hero Core — environment template. Copy to `.env` (git-ignored) and fill in.
# Both the backend and the agents package read the repo-root .env; real env vars win.
#
# Keep comments on their OWN line above a variable, never after it: Docker Compose
# takes the trailing comment as the value when the variable is left empty
# (`FOO=   # note` becomes FOO='# note'), which python-dotenv would have stripped.

# --- Application (backend) ---
APP_ENV=development            # development | test | production
# Required when APP_ENV=production.
SECRET_KEY=
# MongoDB, e.g. mongodb://localhost:27017/menuhero (optional).
DATABASE_URL=
MONGODB_DATABASE=menuhero      # database name, used when DATABASE_URL carries no path
CORS_ORIGINS=http://localhost:3000   # comma-separated
LOG_LEVEL=INFO

# --- Google sign-in + sessions (management app) ---
# Create an OAuth 2.0 *Web application* client at https://console.cloud.google.com/apis/credentials
# and register GOOGLE_REDIRECT_URI verbatim as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The callback goes through the frontend origin (Nuxt proxies /api/* to the backend) so the
# session cookie is set on the host the app is served from. Keep the SAME hostname in both:
# cookies ignore the port but not the host, so localhost vs 127.0.0.1 silently breaks sign-in.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_BASE_URL=http://localhost:3000   # where the sign-in callback sends the browser back to
SESSION_TTL_DAYS=30            # how long the session cookie and its document stay valid
INVITE_TTL_DAYS=14
# Comma-separated; these addresses sign in as platform admin.
BOOTSTRAP_ADMIN_EMAILS=

# --- Google Business Profile import ---
# Lets an owner import a restaurant from their Google Business Profile instead of typing it
# in. There is no on/off switch: it is available wherever it can work, which means the
# GOOGLE_CLIENT_* values above plus a SECRET_KEY (the refresh token Google returns is
# encrypted at rest with a key derived from it). Register this redirect URI on the same
# OAuth client as the sign-in one.
GOOGLE_BUSINESS_REDIRECT_URI=http://localhost:3000/api/v1/google-business/callback
#
# The APIs themselves are allow-listed per Google Cloud project. Until the project is
# approved every call answers PERMISSION_DENIED, which the app surfaces to the owner with
# that explanation rather than failing silently. To get there, in the same project:
#   1. request access at https://developers.google.com/my-business/content/prereqs;
#   2. enable the "My Business Account Management API" and the "My Business Business
#      Information API".
# Onboarding works without any of this - it just shows the manual form.

# --- Agent system (read by the `agents` package, server-side only; NEVER exposed to the browser) ---
LLM_API_KEY=
LLM_PROVIDER=stub              # stub | openai | anthropic | google (only stub is implemented)
LLM_MODEL=
AGENT_TIMEOUT_SECONDS=60

# --- Frontend (Nuxt runtime config overrides; only NUXT_PUBLIC_* reaches the browser) ---
NUXT_PUBLIC_API_BASE=/api
NUXT_API_PROXY_TARGET=http://127.0.0.1:8000
